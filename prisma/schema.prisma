// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"  // Add this line
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  slug          String         @db.VarChar(100) @unique
  description   String?        @db.Text
  displayOrder  Int            @default(0) @map("display_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  subcategories Subcategory[]
  websites      Website[]

  @@map("categories")
  @@index([isActive, displayOrder], name: "idx_category_active_order")
}

model Subcategory {
  id            Int       @id @default(autoincrement())
  categoryId    Int       @map("category_id")
  name          String    @db.VarChar(100)
  slug          String    @db.VarChar(100)
  description   String?   @db.Text
  displayOrder  Int       @default(0) @map("display_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")
  category      Category  @relation(fields: [categoryId], references: [id])
  websites      Website[]

  @@map("subcategories")
  @@unique([categoryId, slug], name: "uk_category_subcategory_slug")
  @@index([categoryId], name: "idx_subcategory_category")
  @@index([isActive, displayOrder], name: "idx_subcategory_active_order")
}

model Pincode {
  id        Int       @id @default(autoincrement())
  pincode   String    @db.VarChar(10) @unique
  city      String    @db.VarChar(100)
  state     String    @db.VarChar(100)
  country   String    @default("India") @db.VarChar(100)
  region    Region?
  latitude  Decimal?  @db.Decimal(10, 7) // Changed from Float? to Decimal?
  longitude Decimal?  @db.Decimal(10, 7) // Changed from Float? to Decimal?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  websites  Website[]

  @@map("pincodes")
  @@index([city], name: "idx_pincodes_city")
  @@index([state], name: "idx_pincodes_state")
  @@index([isActive], name: "idx_pincodes_active")
  @@index([latitude, longitude], name: "idx_pincodes_location")
}

model Website {
  id               BigInt      @id @default(autoincrement())
  websiteId        Int         @map("website_id")
  websiteName      String      @db.VarChar(150) @map("website_name")
  websiteUrl       String      @db.VarChar(255) @map("website_url")
  logoUrl          String?     @db.VarChar(255) @map("logo_url")
  isFeatured       Boolean     @default(false) @map("is_featured")
  status           WebsiteStatus @default(active)
  categoryId       Int         @map("category_id")
  categoryName     String      @db.VarChar(100) @map("category_name")
  categorySlug     String      @db.VarChar(100) @map("category_slug")
  subcategoryId    Int         @map("subcategory_id")
  subcategoryName  String      @db.VarChar(100) @map("subcategory_name")
  subcategorySlug  String      @db.VarChar(100) @map("subcategory_slug")
  pincodeValue     String      @db.VarChar(10) @map("pincode")
  city             String      @db.VarChar(100)
  state            String      @db.VarChar(100)
  category         Category    @relation(fields: [categoryId], references: [id])
  subcategory      Subcategory @relation(fields: [subcategoryId], references: [id])
  pincode          Pincode?    @relation(fields: [pincodeValue], references: [pincode])

  @@map("website")
  @@unique([websiteId, subcategoryId, pincodeValue], name: "uk_website_cat_pincode")
  @@index([status, pincodeValue], name: "idx_status_pincode")
  @@index([categoryId, pincodeValue, status], name: "idx_cat_pincode")
  @@index([subcategoryId, pincodeValue, status], name: "idx_subcat_pincode")
}

enum Region {
  North
  South
  East
  West
  Central
  Northeast
}

enum WebsiteStatus {
  active
  inactive
  pending
}

